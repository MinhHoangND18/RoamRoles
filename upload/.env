# Upload Service Configuration

# Port for the upload service
PORT=8089
HOST=127.0.0.1

# Your domain - used to generate full URLs for uploaded images
BASE_URL=https://jobzestry.com

# Directory to store uploaded files (relative to the service or absolute path)
UPLOAD_DIR=./uploads

# Maximum file size in MB
MAX_FILE_SIZE_MB=10

# Allowed origins for CORS (comma-separated)
ALLOWED_ORIGINS=*
