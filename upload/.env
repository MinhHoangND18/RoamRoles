PORT=8089
HOST=127.0.0.1

# Đường dẫn để Go lưu file vật lý (relative to service directory)
# Service chạy tại /var/www/roam/upload, nên ./uploads sẽ tạo /var/www/roam/upload/uploads
UPLOAD_DIR=./uploads

# Domain để nối vào link trả về
BASE_URL=https://jobzesty.com

ALLOWED_ORIGINS=https://jobzesty.com,http://localhost:3000